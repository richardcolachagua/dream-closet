# Local development:
# Copy the desired settings into .env.development.local.
REACT_APP_USE_FIREBASE_EMULATORS=true
REACT_APP_FIREBASE_EMULATOR_HOST=127.0.0.1

# Keep disabled during the initial refactor.
REACT_APP_ENABLE_ANALYTICS=false
REACT_APP_ENABLE_BILLING=false

# Public reCAPTCHA site key, not a secret key.
REACT_APP_FIREBASE_APPCHECK_SITE_KEY=