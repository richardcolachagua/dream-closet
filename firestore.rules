rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isRegistered() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider != "anonymous";
    }

    function isOwner(userId) {
      return isRegistered() && request.auth.uid == userId;
    }

    function hasOnlyKeys(data, allowed) {
      return data.keys().hasOnly(allowed);
    }

    function onboardingIsValid(data) {
      return data is map
        && data.keys().hasAll([
          "gender",
          "categories",
          "brands",
          "completed"
        ])
        && data.keys().hasOnly([
          "gender",
          "categories",
          "brands",
          "completed"
        ])
        && data.gender in [null, "female", "male"]
        && data.categories is list
        && data.categories.size() <= 60
        && data.categories.toSet().size() == data.categories.size()
        && data.categories.hasOnly([
          "Tops",
          "Blouses",
          "Tank Tops",
          "Crop Tops",
          "Bodysuits",
          "Sweaters",
          "Cardigans",
          "Hoodies",
          "Blazers",
          "Dresses",
          "Mini Dresses",
          "Midi Dresses",
          "Maxi Dresses",
          "Skirts",
          "Mini Skirts",
          "Midi Skirts",
          "Jeans",
          "Pants",
          "Trousers",
          "Leggings",
          "Shorts",
          "Jumpsuits",
          "Rompers",
          "Matching Sets",
          "Activewear",
          "Loungewear",
          "Sleepwear",
          "Swimwear",
          "Outerwear",
          "Jackets",
          "Coats",
          "Heels",
          "Sandals",
          "Sneakers",
          "Boots",
          "Flats",
          "Loafers",
          "Bags",
          "Jewelry",
          "Accessories",
          "Sunglasses",
          "Hats",
          "T-Shirts",
          "Graphic Tees",
          "Button-Ups",
          "Polos",
          "Crewnecks",
          "Suits",
          "Chinos",
          "Cargo Pants",
          "Joggers",
          "Denim Shorts",
          "Vests",
          "Dress Shoes",
          "Watches"
        ])
        && data.brands is list
        && data.brands.size() <= 100
        && data.brands.toSet().size() == data.brands.size()
        && data.completed is bool
        && (
          !data.completed
          || (
            data.gender != null
            && data.categories.size() > 0
          )
        );
    }

    function preferencesIsValid(data) {
      return data is map
        && data.keys().hasAll([
          "emailNotifications"
        ])
        && data.keys().hasOnly([
          "emailNotifications"
        ])
        && data.emailNotifications is bool;
    }

    function profileFieldsAreValid(data) {
      return data.keys().hasAll([
          "firstName",
          "lastName",
          "email",
          "onboarding",
          "preferences",
          "createdAt",
          "updatedAt"
        ])
        && data.firstName is string
        && data.firstName.size() <= 60
        && data.lastName is string
        && data.lastName.size() <= 60
        && data.email is string
        && data.email.size() > 0
        && data.email.size() <= 320
        && onboardingIsValid(data.onboarding)
        && preferencesIsValid(data.preferences)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function userCreateIsValid(userId) {
      return isOwner(userId)
        && request.resource.data.keys().hasOnly([
          "firstName",
          "lastName",
          "email",
          "onboarding",
          "preferences",
          "createdAt",
          "updatedAt"
        ])
        && profileFieldsAreValid(request.resource.data)
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    function userUpdateIsValid(userId) {
      return isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "firstName",
          "lastName",
          "onboarding",
          "preferences",
          "updatedAt"
        ])
        && profileFieldsAreValid(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.email == resource.data.email
        && request.resource.data.updatedAt == request.time;
    }

    function savedItemIsValid() {
      return hasOnlyKeys(request.resource.data, [
          "name",
          "imageUrl",
          "price",
          "numericPrice",
          "productUrl",
          "brand",
          "source",
          "description",
          "createdAt"
        ])
        && request.resource.data.name is string
        && request.resource.data.imageUrl is string
        && request.resource.data.price is string
        && (
          !("numericPrice" in request.resource.data)
          || request.resource.data.numericPrice == null
          || request.resource.data.numericPrice is int
          || request.resource.data.numericPrice is float
        )
        && request.resource.data.productUrl is string
        && request.resource.data.brand is string
        && request.resource.data.source is string
        && request.resource.data.description is string
        && request.resource.data.createdAt is timestamp;
    }

    function savedSearchIsValid() {
      return hasOnlyKeys(request.resource.data, [
          "query",
          "filters",
          "sort",
          "page",
          "createdAt"
        ])
        && request.resource.data.query is string
        && request.resource.data.filters is map
        && request.resource.data.sort is string
        && request.resource.data.page is int
        && request.resource.data.createdAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;

      allow create: if userCreateIsValid(userId);
      allow update: if userUpdateIsValid(userId);
      allow delete: if false;

      match /savedItems/{itemId} {
        allow get, list: if isOwner(userId);

        allow create: if isOwner(userId)
          && savedItemIsValid();

        allow update: if isOwner(userId)
          && request.resource.data.createdAt == resource.data.createdAt
          && savedItemIsValid();

        allow delete: if isOwner(userId);
      }

      match /savedSearches/{searchId} {
        allow get, list: if isOwner(userId);

        allow create: if isOwner(userId)
          && savedSearchIsValid();

        allow update: if isOwner(userId)
          && request.resource.data.createdAt == resource.data.createdAt
          && savedSearchIsValid();

        allow delete: if isOwner(userId);
      }
    }
  }
}